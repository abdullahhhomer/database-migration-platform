# ============================================================
# PostgreSQL - Source Database
# ============================================================

POSTGRES_DB=migration_source
POSTGRES_USER=migration_user
POSTGRES_PASSWORD=migration_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Bulk seed multiplier: 1 = ~700k extra rows (~1M total)
SEED_SCALE=1

# Live traffic: average transactions per second from the generator
GENERATOR_TPS=1

# ============================================================
# Mocked AWS (moto) - S3, Kinesis, DynamoDB, Secrets Manager
# ============================================================

AWS_REGION=us-east-1
AWS_MOCK_PORT=5000
S3_LANDING_BUCKET=migration-landing
KINESIS_STREAM=cdc-changes
KINESIS_SHARDS=2
DYNAMODB_CHECKPOINT_TABLE=cdc-checkpoints

# ============================================================
# Targets
# ============================================================

# Which targets a migration run uses by default
MIGRATION_TARGETS=databricks,sqlserver,mongodb

# SQL Server (stand-in for Amazon RDS for SQL Server).
# The password must be 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Migrat1on_Passw0rd!
SQLSERVER_PORT=1433
MSSQL_MEMORY_LIMIT_MB=2048

# MongoDB (stand-in for Amazon DocumentDB)
MONGO_USER=migration
MONGO_PASSWORD=migration_password
MONGO_PORT=27017

# ============================================================
# Databricks (real Free Edition workspace)
# ============================================================

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=migration_platform
DATABRICKS_SCHEMA=bronze

# ============================================================
# Migration engine
# ============================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Parallel full-load workers (1 = sequential). Compare the timings!
MIGRATION_WORKERS=4

# Random rows per table compared field by field during validation
VALIDATION_SAMPLE_SIZE=200

# ============================================================
# Frontend
# ============================================================

FRONTEND_PORT=3000

# ============================================================
# Application
# ============================================================

LOG_LEVEL=INFO
